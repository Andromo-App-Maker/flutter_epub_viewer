<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      FolioReader themes (FolioActivityDayTheme / FolioActivityNightTheme) predate edge-to-edge.
      Parent styles come from the folioreader AAR. windowOptOutEdgeToEdgeEnforcement still opts
      out on Android 15. Android 16 (API 36) ignores it, so ContentHighlightActivity is inset
      by res/layout/activity_content_highlight.xml instead of relying on this flag.
    -->
    <style name="FolioReaderWindowFixDayTheme" parent="@style/FolioActivityDayTheme">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <!-- API 35: opt out of mandatory edge-to-edge for this activity (temporary escape hatch). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="FolioReaderWindowFixNightTheme" parent="@style/FolioActivityNightTheme">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
